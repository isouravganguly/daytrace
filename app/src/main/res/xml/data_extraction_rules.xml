<?xml version="1.0" encoding="utf-8"?>
<!-- The daytrace prefs hold the device token: never back them up or transfer them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="daytrace.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="daytrace.xml" />
    </device-transfer>
</data-extraction-rules>
